generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RewardBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum RewardRecordStatus {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum RewardBatchType {
  REGULAR
  ADJUSTMENT
}

enum LedgerType {
  REWARD
  ROLLBACK
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
}

enum PartnerTier {
  NONE
  COLLECTIVE
  TOP_SHELF
  CRAFT
  STUDIO
  ICON
}

model RewardBatch {
  id          Int               @id @default(autoincrement())
  period      String            @unique // e.g. 2026-Q1
  batchType   RewardBatchType   @default(REGULAR)
  parentPeriod String?
  triggeredBy String?
  startDate   DateTime
  endDate     DateTime
  status      RewardBatchStatus @default(PENDING)
  rewardRate  Decimal           @db.Decimal(8, 6)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  records     RewardRecord[]

  @@index([status, createdAt])
}

model RewardRecord {
  id               Int                @id @default(autoincrement())
  batchId          Int
  customerId       Int
  customerName     String?
  customerEmail    String?
  totalOrderAmount Decimal            @db.Decimal(18, 2)
  bobReward        Decimal            @default(0) @db.Decimal(18, 2)
  csReward         Decimal            @default(0) @db.Decimal(18, 2)
  rewardAmount     Decimal            @db.Decimal(18, 2)
  status           RewardRecordStatus @default(PENDING)
  attemptCount     Int                @default(0)
  lastError        String?
  nextRetryAt      DateTime?
  processedAt      DateTime?
  rollbackReason   String?
  rollbackBy       String?
  rollbackAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  batch            RewardBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  ledgers          BeansLedger[]

  @@unique([batchId, customerId])
  @@index([status, nextRetryAt])
}

model BeansLedger {
  id             Int        @id @default(autoincrement())
  customerId     Int
  rewardRecordId Int?
  changeAmount   Decimal    @db.Decimal(18, 2) // positive for reward, negative for rollback
  type           LedgerType
  referenceId    String     // batchId:recordId or rollbackJobId
  idempotencyKey String     @unique
  externalTxnId  String?
  metadata       Json?
  createdAt      DateTime   @default(now())

  rewardRecord   RewardRecord? @relation(fields: [rewardRecordId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([referenceId, type])
}

model CustomerQuarterSnapshot {
  id            Int         @id @default(autoincrement())
  customerId    Int
  customerName  String?
  customerEmail String?
  season        String      // e.g. 2026-Q1
  totalAmount   Decimal     @db.Decimal(18, 2)
  bobAmount     Decimal     @db.Decimal(18, 2)
  csAmount      Decimal     @db.Decimal(18, 2)
  level         PartnerTier
  isExistingCustomer Boolean @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customerId, season])
  @@index([season, level])
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
